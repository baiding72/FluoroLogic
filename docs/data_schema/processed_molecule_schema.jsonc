{
    // ================= 基础元数据 =================
    "id": "BE_23NO2",           // 分子唯一标识符 (通常来自文件名)
    "is_bodipy": true,          // 【骨架识别】 是否通过 N-B-N 闭环验证
    "is_dimer": false,          // 【二聚体过滤】 是否为二聚体 (false 代表是标准单体，适合分析)
    "smiles": "[B-]1...)(F)F",  // 分子的完整 SMILES (包含立体化学信息)

    // ================= 取代基深度分析 (核心部分) =================
    // 键 (Key): 骨架原子在原分子中的索引 (Core Atom Index)
    // 值 (Value): 连接在该骨架原子上的取代基列表
    "substituents": {
        // --- 实例 1: N 原子上连接的 B 碎片 ---
        "1": [  // 索引 1 是骨架上的一个氮原子
            {
                "type": "nitrogen",         // 类型：N 连接位点
                "smiles": "FBF",            // 提取出的 SMILES (表明是标准 BF2，或者是取代 B)
                "atom_idx": [0, 68, 67],    // 【关键】取代基所有原子的原始索引 (用于 3D 可视化)
                "root_idx": 0               // 直接连接在骨架(索引1)上的原子是索引 0 (即 B 原子)
            }
        ],
        
        // --- 实例 2: Alpha 位 (3,5-位) 取代 ---
        "2": [ // 索引 2 是靠近 N 的骨架碳 (Alpha 位)
            {
                "type": "alpha",            // 类型：Alpha 位取代基
                // 这是一个长链/复杂基团，SMILES 完整保留了化学结构
                "smiles": "[H]CC([H])C1...", 
                // 包含了该长链上所有 40 个原子的索引，用于计算这一坨东西的空间体积
                "atom_idx": [48, 103, ... 105], 
                "root_idx": 48              // 长链的锚点原子
            }
        ],

        // --- 实例 3: Beta 位 (2,6-位) 取代 ---
        "3": [ // 索引 3 是 Beta 碳
            {
                "type": "beta",
                "smiles": "[H]",            // 这里是氢原子，说明没有取代
                "atom_idx": [69],
                "root_idx": 69
            }
        ],

        // --- 实例 4: Meso-Flanking (1,7-位) 取代 ---
        "4": [ // 索引 4 是紧邻 Meso 位的骨架碳
            {
                "type": "meso_flanking",    // 【关键类型】这个位置的位阻直接决定 Meso 苯环是否垂直
                "smiles": "[H]C([H])[H]",   // 这是一个甲基 (Methyl)
                "atom_idx": [47, 102, 101, 100],
                "root_idx": 47
            }
        ],

        // --- 实例 5: Meso 位取代 ---
        "6": [ // 索引 6 是 Meso 碳 (C8)
            {
                "type": "meso",
                "smiles": "[H]C1C([H])...", // 提取出的 Meso 取代基 (看起来是一个含硝基的复杂环/链)
                "atom_idx": [7, 9, ... 8],
                "root_idx": 7
            }
        ]
        // ... (其他位点类似，对应骨架的对称部分) ...
    },

    // ================= 3D 空间效应量化指标 =================
    "steric_properties": {
        // --- 核心指标 3: 最大垂直高度 (Steric Height) ---
        // 物理含义：取代基向平面外伸出了多远 (越大 = 越垂直/位阻越大)
        "steric_heights": {
            "max_height_overall": 3.716,       // 全局最高点 (通常是 Alpha 位长链伸出去的)
            "max_height_meso_flanking": 2.311, // 【极重要】Meso 旁边的甲基高度 2.3Å
                                               // 说明这个甲基不在平面内，可能挤压了 Meso 苯环
            "max_height_beta": 0.0,            // Beta 位是 H，高度为 0 (共面)
            "max_height_alpha": 3.716          // Alpha 位长链伸得很远
        },

        // --- 核心指标 1: 骨架平面性 ---
        "core_rmsd": 0.0245,           // 0.02 Å -> 骨架非常平整 (Planar)
        "max_out_of_plane": 0.0448, // 最大翘曲也很小，说明共轭骨架未被破坏

        // --- 核心指标 4: 对称性破坏 ---
        "mass_asymmetry": 0.224,  // 0.224 表示有一定的不对称性 (0 是完全对称)
        "left_mass": 330.2,       // 左半球质量
        "right_mass": 209.1       // 右半球质量 (左右不对称可能导致 LUMO 局域化)
    },

    // ================= 电化学势能信息 =================
    "potential_info": {
        "dft_potential_csv_V": -1.302, // 实验/文献对照值 (如果有)
        "calc_energy_gap_eV": -3.713   // 计算出的能隙 (Reduced Energy - Neutral Energy)
    },

    // ================= 光学性质 (本例缺失) =================
    "optical_properties": {
        "abs_max_nm": NaN
    },

    // ================= 构象态对比 (机理分析) =================
    "states": {
        "neutral": {
            "energy_ev": -90387.0199,
            "dihedral_angle": 85.5 // 中性态 Meso 二面角 ~85.5° (垂直构象)
        },
        "reduced": {
            "energy_ev": -90390.7328,
            "dihedral_angle": 86.0 // 还原态 Meso 二面角 ~86.0°
                                   // 结论：还原前后构象几乎不变 (Rigid)
        }
    },

    // ================= 重组能指标 =================
    "reorganization_metrics": {
        "delta_dihedral": 0.5,      // 角度变化仅 0.5°
        "reorganization_type": "Rigid" // 判定为刚性分子，重组能小，利于电子传输
    }
}